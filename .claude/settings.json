{
  "permissions": {
    "allow": [
      "Bash(pnpm run lint-check:*)",
      "Bash(pnpm run type-check:*)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run analyze:*)",
      "Bash(pnpm run serve:*)",
      "Bash(pnpm run start:*)",
      "Bash(pnpm run test-open:*)",
      "Bash(pnpm run test-run:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm start:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm --version)",
      "Bash(node --version)",
      "Bash(node .claude/scripts/render-audit.mjs:*)",
      "Bash(node .claude/scripts/unpack.mjs:*)",
      "Bash(pnpm dlx js-yaml:*)",
      "Bash(npx -y js-yaml:*)",
      "Bash(npx -y json2yaml:*)",
      "Bash(npx -y swagger2openapi:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(pnpm run lint-check:*)",
      "PowerShell(pnpm run type-check:*)",
      "PowerShell(pnpm run check:*)",
      "PowerShell(pnpm run build:*)",
      "PowerShell(pnpm run analyze:*)",
      "PowerShell(pnpm run test-open:*)",
      "PowerShell(pnpm run test-run:*)",
      "PowerShell(pnpm build:*)",
      "PowerShell(pnpm start:*)",
      "PowerShell(pnpm exec eslint:*)",
      "PowerShell(node .claude/scripts/render-audit.mjs:*)",
      "PowerShell(node .claude/scripts/unpack.mjs:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/require-init.mjs"
          }
        ]
      }
    ]
  }
}