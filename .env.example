# --- Client side variables ---
NEXT_PUBLIC_DOMAIN= # Frontend URL
NEXT_PUBLIC_API_URL= # Backend URL
NEXT_PUBLIC_MEDIA_URL= # Bucket URL

NEXT_PUBLIC_APP_ENV= # 'development', 'staging', or 'production'

NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # Cloudflare Turnstile site key. Empty = no challenge widget on the contact form


# --- Server side variables ---

# Only use these variables if you are using the auth flow
AUTH_SECRET= # Secret for JWT - Generate with "openssl rand -hex 16"
AUTH_DEFAULT_USER= # Default user for auth flow
AUTH_DEFAULT_PASSWORD= # Default password for auth flow
MAILSLURP_API_KEY= # MailSlurp API Key

# Only use these variables if you are using the contact form (src/app/api/contact/route.ts)
RESEND_API_KEY= # Resend API key, sending access only
CONTACT_TO= # Inbox that receives the form. With no verified domain it MUST be the Resend account owner's address
CONTACT_FROM= # 'Brand <contact@your-verified-domain.com>'. Empty = Resend's sandbox sender, which only delivers to CONTACT_TO above when it is the account owner
TURNSTILE_SECRET_KEY= # Cloudflare Turnstile secret. Empty = the route skips the human check

# Only use these variables if you are using Sentry
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=